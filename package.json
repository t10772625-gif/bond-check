{
  "name": "BondCheck",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/configure.mjs",
    "configure": "node scripts/configure.mjs",
    "preandroid": "node scripts/configure.mjs",
    "preios": "node scripts/configure.mjs",
    "prestart": "node scripts/configure.mjs",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:parser": "node automation/test-rs100-200-750-1500.mjs && node automation/test-premium-25000-40000.mjs",
    "test:automation": "node --test automation/core.test.mjs automation/pipeline.test.mjs",
    "check:corpus": "node automation/check-corpus.mjs automation/sources.txt",
    "worker:documents": "node scripts/document-worker.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-share": "^12.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
